# ──────────────────────────────────────────────────
# Environment Variables — ANNT NANDAS FOUNDATION
# ──────────────────────────────────────────────────
#
# Phase 1 uses a built-in mock API route (/api/data) that serves
# content from src/lib/data.ts. When you connect a real CMS or
# backend, set API_URL to your backend's origin and
# every API call in src/lib/api.ts will automatically target it.

# ── Backend / CMS Origin ──────────────────────────
# Leave empty to use the built-in mock route (development).
# Example for production:
# API_URL=https://cms.anntnandasfoundation.com
API_URL=

# ── Site URL (optional, used for SEO defaults) ────
NEXT_PUBLIC_SITE_URL=https://anntnandasfoundation.com
