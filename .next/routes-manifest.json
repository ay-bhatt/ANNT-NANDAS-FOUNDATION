{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/donate",
      "regex": "^/donate(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/donate(?:/)?$"
    },
    {
      "page": "/employee-registration",
      "regex": "^/employee\\-registration(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/employee\\-registration(?:/)?$"
    },
    {
      "page": "/events",
      "regex": "^/events(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/events(?:/)?$"
    },
    {
      "page": "/gallery",
      "regex": "^/gallery(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/gallery(?:/)?$"
    },
    {
      "page": "/general-registration",
      "regex": "^/general\\-registration(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/general\\-registration(?:/)?$"
    },
    {
      "page": "/news",
      "regex": "^/news(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/news(?:/)?$"
    },
    {
      "page": "/our-work",
      "regex": "^/our\\-work(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/our\\-work(?:/)?$"
    },
    {
      "page": "/programs",
      "regex": "^/programs(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/programs(?:/)?$"
    },
    {
      "page": "/running-registration",
      "regex": "^/running\\-registration(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/running\\-registration(?:/)?$"
    },
    {
      "page": "/volunteer-registration",
      "regex": "^/volunteer\\-registration(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/volunteer\\-registration(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}